# --- local development ---------------------------------------------------------------------------
# Leave the URLs empty: requests go through the Vite proxy (same origin, no CORS).
VITE_API_URL=
VITE_PLATFORM_URL=
DEV_API_URL=http://localhost:8080        # team backend (auth, analytics, alerts, audit, reports, admin)
DEV_PLATFORM_URL=http://localhost:8081   # data platform (ingestion, sensor health, simulator, forecast)
# "true" runs the entire UI on the built-in mock backend. `npm run dev:mock` sets it for you.
VITE_USE_MOCKS=false
# "true" once the team backend serves /ws (/topic/risk, /topic/alerts). Pages poll either way.
VITE_BACKEND_LIVE=false
# Demo only: endpoints teammates haven't built yet (404/501) are answered by the mock backend and labelled
# "Sample data". Real endpoints are never replaced. Leave false for an honest view of what exists.
VITE_MOCK_FALLBACK=false
