<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>edu.neu.ecp</groupId><artifactId>ecp-platform-parent</artifactId><version>0.2.0-SNAPSHOT</version></parent>
  <artifactId>ecp-health</artifactId>
  <description>Sensor health service: offline, stuck, impossible, erratic, lossy, bad-signature and clock-skew detection</description>
  <dependencies>
    <dependency><groupId>edu.neu.ecp</groupId><artifactId>ecp-common</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build><plugins><plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
    <!-- scripts/evaluate-health-intel-lab.sh: replay the Intel Berkeley Lab data through the health rules -->
    <configuration><mainClass>edu.neu.ecp.health.realdata.IntelLabEvaluation</mainClass></configuration></plugin></plugins></build>
</project>
